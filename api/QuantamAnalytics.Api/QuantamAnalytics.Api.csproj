<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API host. Minimal-API style routing (no MVC controllers needed for now).
    Real endpoints come in later PRs:
      PR-09  Public job board endpoints
      PR-11  Recruiter endpoints
  -->

  <PropertyGroup>
    <RootNamespace>QuantamAnalytics.Api</RootNamespace>
    <AssemblyName>QuantamAnalytics.Api</AssemblyName>
    <UserSecretsId>quantamanalitics-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantamAnalytics.Domain\QuantamAnalytics.Domain.csproj" />
    <ProjectReference Include="..\QuantamAnalytics.Infrastructure\QuantamAnalytics.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core design-time tooling. Required so `dotnet ef` can target this
      project as the startup. PrivateAssets="all" keeps the dependency from
      flowing through to anything that references the API.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Auth0 JWT validation (PR-06). The provider is generic JWT bearer; the
         Auth0-specific bits (issuer, audience, custom roles claim) are wired
         in Auth/AuthExtensions.cs. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
  </ItemGroup>

</Project>
