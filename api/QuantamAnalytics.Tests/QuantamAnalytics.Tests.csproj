<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration test project. Uses WebApplicationFactory<TEntryPoint> against
    QuantamAnalytics.Api in-process — no real network, no real DB. Fixtures
    that need a database (PR-03 onward) will spin up Postgres via Testcontainers.
  -->

  <PropertyGroup>
    <RootNamespace>QuantamAnalytics.Tests</RootNamespace>
    <AssemblyName>QuantamAnalytics.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707 forbids underscores in member names — a public-API rule that
      breaks the xUnit convention `Method_describes_what_it_tests`. Test
      methods aren't a public surface, so the rule has no consumer.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <!--
      Spins a real Postgres in Docker for integration tests that need to
      exercise EF Core query filters end-to-end. Used by the tenant-
      isolation IT (PR-30). Requires Docker on the dev machine; CI's
      ubuntu-24.04 GitHub-hosted runner has Docker preinstalled.
    -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantamAnalytics.Api\QuantamAnalytics.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Global usings for the test assembly. Saves a `using Xunit;` (and a
      `using FluentAssertions;`) at the top of every test file. Keeps test
      bodies tight and matches what `dotnet new xunit` ships in its Usings.cs.
    -->
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
