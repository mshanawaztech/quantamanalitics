<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer: EF Core context, migrations, repositories, and
    external service clients (R2, Auth0, Resend, Checkr, etc.). Depends on
    Domain. EF Core 10 + Npgsql land here in PR-03; auth/storage clients
    follow in later PRs.
  -->

  <PropertyGroup>
    <RootNamespace>QuantamAnalytics.Infrastructure</RootNamespace>
    <AssemblyName>QuantamAnalytics.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantamAnalytics.Domain\QuantamAnalytics.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.22.2" />
    <!--
      Pinned to 10.0.1 because EFCore.NamingConventions 10.0.0 transitively
      requires Microsoft.EntityFrameworkCore >= 10.0.1, and Directory.Build.props
      treats NU1605 (package downgrade) as an error.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!--
      In-memory EF provider used ONLY as the non-production fallback when
      no Postgres connection string is configured (e.g. integration tests
      that exercise endpoint pipelines via plain WebApplicationFactory<Program>
      without spinning up a testcontainer). See AddInfrastructure() in
      DependencyInjection.cs.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />

    <!-- Snake_case naming so generated SQL matches Postgres conventions -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />

    <!-- DI extension types used by AddInfrastructure() -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />

    <!-- DB connectivity health check used by /ready -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.1" />

    <!--
      QuestPDF renders invoices server-side without a headless browser
      dependency. Community license is free for organizations under
      $1M revenue / 10 staff (per https://www.questpdf.com/pricing.html).
      We acknowledge the license programmatically in Program.cs.
    -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

</Project>
